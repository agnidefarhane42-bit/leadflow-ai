# Database
DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth
JWT_SECRET=change-this-to-a-long-random-string

# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-large-latest

# Google Calendar (for RDV booking)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Email notifications (optional - use Resend free tier)
RESEND_API_KEY=

# Payment — Fedapay (https://fedapay.com)
# Create account at https://dashboard.fedapay.com
# Get API keys from Settings > API Keys
FEDAPAY_API_KEY=your-fedapay-secret-key
FEDAPAY_PUBLIC_KEY=your-fedapay-public-key
FEDAPAY_API_URL=https://api.fedapay.com/v1

# Alternative: Paystack (https://paystack.com)
# PAYSTACK_SECRET_KEY=sk_live_xxx
# PAYSTACK_PUBLIC_KEY=pk_live_xxx
