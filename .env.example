# Database
DATABASE_URL=postgres://user:password@ep-xxx.neon.tech/dbname?sslmode=require

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth
JWT_SECRET=change-this-to-a-long-random-string

